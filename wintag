#!/bin/bash
# wintag：Docker コンテナで動く GUI アプリのウィンドウタイトルの先頭にコンテナ名を付け、同じアプリのウィンドウを見分けられるようにする
# 使い方：
#   wintag on      … ウィンドウ監視をオン（すぐに開始し、ログイン時にも自動で開始）
#   wintag off     … ウィンドウ監視をオフ（既定）
#   wintag watch   … ウィンドウを監視してタイトルを付ける（on で起動される）

# ===== パラメータ =====
AUTOSTART_FILE="${HOME}/.config/autostart/wintag-watch.desktop"  # 監視オン時に作るログイン時の自動起動設定
TITLE_FORMAT="[%s] "                             # ウィンドウタイトルの先頭に付けるコンテナ名の書式
HELP_LINES="2,6p"                                # ヘルプとして表示する行範囲
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/wintag-watch-${UID}.lock"  # watch の多重起動防止用ロック（中身は watch の PID）
SELF="$(readlink -f "$0")"                       # このスクリプト自身の絶対パス
SOURCE_SCRIPT="/usr/lib/wintag/wintag-source.py" # 起動元のコンテナを判定するスクリプト

# 機能：ウィンドウがコンテナのアプリなら、タイトルに付ける接頭辞を返す
# 入力：$1 ウィンドウ ID
# 出力：接頭辞（例「[whillLocalizer] 」）を標準出力へ。ホストのアプリ・判定できないウィンドウは何も出力しない
title_prefix() {
  local cid name
  cid="$(python3 "${SOURCE_SCRIPT}" "$1")"
  [ -n "${cid}" ] || return
  # コンテナ名（Docker に問い合わせられなければ ID 先頭 12 桁）
  name="$(docker inspect -f '{{.Name}}' "${cid}" 2>/dev/null)"
  name="${name#/}"
  # shellcheck disable=SC2059
  printf "${TITLE_FORMAT}" "${name:-${cid:0:12}}"
}

# 機能：ウィンドウタイトルの先頭に接頭辞を付け、アプリがタイトルを変えるたびに付け直す
# 入力：$1 ウィンドウ ID, $2 接頭辞, 標準入力 xprop -notype -spy _NET_WM_NAME の出力
# 出力：ウィンドウタイトルの変更
keep_title() {
  local win="$1" prefix="$2" line title
  while read -r line; do
    # 「_NET_WM_NAME = "タイトル"」以外（not found など）は無視
    [[ "${line}" == *' = "'*'"' ]] || continue
    title="${line#*= \"}"
    title="${title%\"}"
    # xprop が付けたエスケープ（\\ と \"）を戻す
    title="${title//\\\\/$'\x01'}"
    title="${title//\\\"/\"}"
    title="${title//$'\x01'/\\}"
    [[ "${title}" == "${prefix}"* ]] && continue
    xprop -id "${win}" -f _NET_WM_NAME 8u -set _NET_WM_NAME "${prefix}${title}"
  done
}

# 機能：ウィンドウ一覧を監視し、新しく開いたコンテナのアプリのウィンドウにタイトルを付ける（常駐）
# 入力：なし
# 出力：なし
watch_windows() {
  local line w prefix
  local -A prev=() cur=()
  declare -gA SPIES=()

  # 2 つ動かないよう 1 つに限る。off で止められるよう PID を書いておく
  exec 9> "${LOCK_FILE}"
  flock -n 9 || { echo "wintag watch は既に動いています" >&2; exit 1; }
  echo "$$" >&9

  # 終了時に、タイトル監視とウィンドウ一覧の監視を止める
  trap 'kill "${SPIES[@]}" "${ROOT_SPY}" 2>/dev/null' EXIT
  trap 'exit 0' TERM INT HUP

  # ウィンドウ一覧（_NET_CLIENT_LIST）が変わるたびに 1 行届く（子プロセスにはロックを引き継がない）
  exec 3< <(xprop -root -spy _NET_CLIENT_LIST 9>&-)
  ROOT_SPY=$!
  while read -r line <&3; do
    cur=()
    for w in $(grep -o '0x[0-9a-fA-F]*' <<< "${line}"); do
      cur[$w]=1
      [ -z "${prev[$w]}" ] || continue
      prefix="$(title_prefix "$w" 9>&-)"
      [ -n "${prefix}" ] || continue
      # ウィンドウごとにタイトルを監視し、接頭辞を付け続ける（ウィンドウが閉じると xprop は終了する）
      xprop -id "$w" -notype -spy _NET_WM_NAME 9>&- 2>/dev/null > >(keep_title "$w" "${prefix}" 9>&-) &
      SPIES[$w]=$!
    done
    # 閉じたウィンドウのタイトル監視を片付け、今回の一覧を次回の比較用に保存
    for w in "${!SPIES[@]}"; do
      [ -n "${cur[$w]}" ] || { kill "${SPIES[$w]}" 2>/dev/null; unset "SPIES[$w]"; }
    done
    prev=()
    for w in "${!cur[@]}"; do
      prev[$w]=1
    done
  done
}

# 機能：ウィンドウ監視をオンにする（ログイン時の自動起動を設定し、動いていなければすぐに開始）
# 入力：なし
# 出力：自動起動設定の作成と結果の表示
watch_on() {
  mkdir -p "$(dirname "${AUTOSTART_FILE}")"
  cat > "${AUTOSTART_FILE}" <<EOF
[Desktop Entry]
Type=Application
Name=wintag
Comment=Show the source Docker container in GUI app window titles
Exec=${SELF} watch
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF
  # ロックを取れる＝動いていない
  flock -n "${LOCK_FILE}" true && setsid -f "${SELF}" watch > /dev/null 2>&1
  echo "ウィンドウ監視をオンにしました（ログイン時にも自動で開始します）"
}

# 機能：ウィンドウ監視をオフにする（自動起動の設定を消し、動いている watch を止める）
# 入力：なし
# 出力：自動起動設定の削除と結果の表示
watch_off() {
  rm -f "${AUTOSTART_FILE}"
  # ロックを取れない＝動いている
  [ -f "${LOCK_FILE}" ] && ! flock -n "${LOCK_FILE}" true && kill "$(cat "${LOCK_FILE}")"
  echo "ウィンドウ監視をオフにしました"
}

# サブコマンドの振り分け
case "$1" in
  on)    watch_on ;;
  off)   watch_off ;;
  watch) watch_windows ;;
  *)     sed -n "${HELP_LINES}" "${SELF}" ;;
esac
